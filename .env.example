NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LOCAL_PREVIEW=false
# For localhost-only backend testing without LINE. Keep both false for LIFF/ngrok.
NEXT_PUBLIC_LOCAL_TEST_LOGIN=false
ALLOW_LOCAL_TEST_LOGIN=false
APP_ORIGIN=https://liff.example.com
WEALTHVAULT_BACKEND_URL=https://wealth.narutchai.com/api/
# Set true only with http://127.0.0.1:8080/api/ while running `pnpm dev`.
ALLOW_LOCAL_HTTP_BACKEND=false
WEALTHVAULT_LIFF_CHANNEL_ID=
# LINE Official Account Messaging API channel (server only; never use the LINE Login channel secret here).
LINE_OA_CHANNEL_SECRET=
LINE_OA_CHANNEL_ACCESS_TOKEN=
REDIS_URL=rediss://user:password@redis.example:6379
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
